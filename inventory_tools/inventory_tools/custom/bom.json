{
  "custom_fields": [
    {
      "default": "0",
      "dt": "BOM",
      "fieldname": "is_subcontracted",
      "fieldtype": "Check",
      "insert_after": "allow_alternative_item",
      "label": "Is Subcontracted",
      "module": "Inventory Tools",
      "name": "BOM-is_subcontracted"
    },
    {
      "allow_on_submit": 1,
      "dt": "BOM",
      "fieldname": "create_job_cards_automatically",
      "fieldtype": "Select",
      "insert_after": "set_rate_of_sub_assembly_item_based_on_bom",
      "label": "Create Job Card(s) Automatically",
      "module": "Inventory Tools",
      "name": "BOM-create_job_cards_automatically",
      "options": "\nYes\nNo"
    },
    {
      "allow_on_submit": 1,
      "dt": "BOM",
      "fieldname": "overproduction_percentage_for_work_order",
      "fieldtype": "Percent",
      "insert_after": "create_job_cards_automatically",
      "label": "Overproduction Percentage For Work Order",
      "module": "Inventory Tools",
      "name": "BOM-overproduction_percentage_for_work_order"
    },
    {
      "depends_on": "eval:doc.with_operations && (doc.operations || []).length",
      "dt": "BOM",
      "fieldname": "operation_flowchart",
      "fieldtype": "HTML",
      "insert_after": "operations",
      "label": "Operation Flowchart",
      "module": "Inventory Tools",
      "name": "BOM-operation_flowchart"
    }
  ],
  "doctype": "BOM",
  "property_setters": [],
  "sync_on_migrate": 1
}